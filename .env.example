# Copie este arquivo para .env e preencha os valores.
# .env nunca entra no git (já coberto pelo .gitignore).

# Base da URL do viewer. Default já aponta para produção.
VIEWER_BASE=https://biodesignlab.com.br/case/

# ---- Cloudflare R2 (único destino desde o Sprint 3c) ----

# Account ID da Cloudflare. Visível no painel R2 > Account Details.
# Usado para montar o endpoint S3: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Access Key + Secret do token "mesh-processor" (R2 > Manage R2 API Tokens).
# Escopo mínimo: Leitura/gravação para objeto, apenas no bucket clinical-3d.
# Obrigatórios em produção; opcionais quando DRY_RUN=true.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket dos modelos (GLB) e dos exames (NRRD + JSON). Default: clinical-3d.
R2_BUCKET=clinical-3d

# ---- Exame de imagem: séries extras ----

# Segredo que assina o write_token devolvido pelo /upload (HMAC do uid). Com ele
# a página de upload envia as séries 1..3 do exame em POST /cases/{uid}/exam.
# Obrigatório em produção; opcional quando DRY_RUN=true. Gere um valor longo e
# aleatório, por exemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
EXAM_WRITE_SECRET=

# Quando true, não chama o R2 — só registra no log (ou grava em DRY_RUN_GLB_DIR).
# Use em dev/CI para poupar ops do R2 e rodar sem credenciais.
DRY_RUN=false
